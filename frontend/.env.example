# Copy to .env.local and fill in. Next inlines NEXT_PUBLIC_* at build time, so set
# it as a build-time variable on Railway too.

# Mapbox public access token (pk.…) for the Map tab. Restrict it to the app's URL
# at https://console.mapbox.com/account/access-tokens/.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Public address of the app, used for the absolute URLs link previews (WhatsApp, Instagram, ...)
# need in a shared route's page. Defaults to http://localhost:3000.
SITE_URL=
